+"""Compare the commands emitted by original and NDF launchers, not copied constants."""
+import ast
+import argparse
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+from unittest.mock import patch
+import sys
+
+ROOT=Path(__file__).resolve().parents[1]
+
+
+class TrainingArgumentTests(unittest.TestCase):
+    def command(self,script,**extra):
+        with tempfile.TemporaryDirectory() as tmp:
+            tool=Path(tmp)/'torchrun'
+            tool.write_text('#!/usr/bin/env python3\nimport sys,json,os\nopen(os.environ["CAPTURE"],"w").write(json.dumps(sys.argv[1:]))\n')
+            tool.chmod(0o755)
+            output=Path(tmp)/'args.json'
+            env=dict(os.environ,PATH=tmp+os.pathsep+os.environ['PATH'],CAPTURE=str(output))
+            for name in ('MODE','TASK','NDF_CONFIG','SMOKE_ONLY','TRAIN_ITERS','NGPUS','EXP_NAME','DATASET_DIR'):
+                env.pop(name,None)
+            env.update(extra)
+            subprocess.run(['bash',str(ROOT/'scripts/rlbench'/script)],cwd=ROOT,env=env,check=True)
+            return json.loads(output.read_text())
+
+    def parse(self,arguments):
+        tree=ast.parse((ROOT/'main.py').read_text())
+        fn=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='parse_arguments')
+        env={'argparse':argparse,'Path':Path,'__file__':str(ROOT/'main.py'),
+             'str2bool':lambda v:v.lower()=='true','str_none':lambda v:None if v=='None' else v}
+        exec(compile(ast.Module(body=[fn],type_ignores=[]),'main.py','exec'),env)
+        start=arguments.index('main.py')+1
+        with patch.object(sys,'argv',['main.py']+arguments[start:]):
+            return vars(env['parse_arguments']())
+
+    def test_all_training_parameters_match_uploaded_launcher(self):
+        original=self.parse(self.command('train_peract.sh'))
+        new=self.parse(self.command('train_peract_ndf.sh'))
+        allowed={'train_data_dir','eval_data_dir','exp_log_dir','checkpoint','ndf_config'}
+        differences={k for k in original if original[k]!=new[k]}
+        self.assertEqual(differences,allowed)
+        self.assertEqual(new['batch_size'],16)
+        self.assertEqual(new['train_iters'],300000)
+        self.assertEqual(new['ndf_config'],'configs/ndf.json')
+
+    def test_baseline_mode_and_paths_with_spaces(self):
+        args=self.parse(self.command('train_peract_ndf.sh',MODE='baseline',DATASET_DIR='/data/my dataset',EXP_NAME='baseline test'))
+        self.assertIsNone(args['ndf_config'])
+        self.assertEqual(args['train_data_dir'],Path('/data/my dataset/train.zarr'))
+        self.assertEqual(args['exp_log_dir'],Path('baseline test'))
+
+    def test_task_and_gpu_selection(self):
+        command=self.command('train_peract_ndf.sh',TASK='open_drawer',NGPUS='2')
+        args=self.parse(command)
+        self.assertEqual(command[command.index('--nproc_per_node')+1],'2')
+        self.assertEqual(args['train_data_dir'],Path('zarr_datasets/peract_open_drawer/train.zarr'))
+        self.assertEqual(args['batch_size'],16)
+
+    def test_smoke_uses_same_arguments_with_separate_entrypoint(self):
+        args=self.command('train_peract_ndf.sh',SMOKE_ONLY='1')
+        self.assertEqual(args[args.index('--module')+1],'tools.smoke_train')
