+import json
+from pathlib import Path
+import tempfile
+from types import SimpleNamespace
+import unittest
+from modeling.ndf.config import NDFConfig, MODEL_KEYS, metadata, check_resume
+
+
+class ConfigurationTests(unittest.TestCase):
+    def test_relative_checkpoint_path(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            p=Path(tmp)/'ndf.json'
+            p.write_text(json.dumps({'checkpoint':'weights.pth'}))
+            self.assertEqual(NDFConfig.read(p).checkpoint,str(Path(tmp)/'weights.pth'))
+
+    def test_bad_settings(self):
+        for kw in ({'num_points':19},{'latent_dim':0},{'query_chunk_size':0},{'scaling':float('nan')}):
+            with self.subTest(kw=kw), self.assertRaises(ValueError): NDFConfig(**kw)
+
+    def test_resume_rejects_different_architecture_or_missing_ndf(self):
+        a=SimpleNamespace(**{k:0 for k in MODEL_KEYS},ndf_settings=NDFConfig().to_dict())
+        saved=metadata(a)
+        check_resume(saved,a)
+        a.ndf_settings={**a.ndf_settings,'checkpoint':'moved.pth'}
+        check_resume(saved,a)
+        a.ndf_settings=None
+        with self.assertRaises(ValueError): check_resume(saved,a)
+        a.ndf_settings=NDFConfig().to_dict()
+        a.embedding_dim=120
+        with self.assertRaises(ValueError): check_resume(saved,a)
