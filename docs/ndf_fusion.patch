+import importlib.util
+from pathlib import Path
+import tempfile
+import unittest
+
+HAS_TORCH=importlib.util.find_spec('torch') is not None
+if HAS_TORCH:
+    import torch
+    from modeling.ndf.config import NDFConfig
+    from modeling.ndf.fusion import FrozenNDFFusion
+
+
+@unittest.skipUnless(HAS_TORCH,'PyTorch unavailable')
+class FrozenFusionTests(unittest.TestCase):
+    def setUp(self):
+        torch.manual_seed(7)
+        torch.set_num_threads(1)
+        self.config=NDFConfig(latent_dim=8,num_points=32,query_chunk_size=3)
+        self.model=FrozenNDFFusion(12,self.config,load_pretrained=False)
+        self.pcd=torch.randn(2,1,3,8,8)*.08
+        self.q=torch.randn(2,9,3)*.08
+        self.visual=torch.randn(2,9,12,requires_grad=True)
+
+    def test_identity_initialization_and_gradients(self):
+        self.model.train()
+        result=self.model(self.pcd,self.q,self.visual)
+        torch.testing.assert_close(result,self.visual)
+        result.square().mean().backward()
+        self.assertIsNotNone(self.visual.grad)
+        self.assertGreater(self.model.fusion.weight.grad[:,12:].abs().sum().item(),0)
+        self.assertFalse(self.model.field.training)
+        self.assertTrue(all(p.grad is None and not p.requires_grad for p in self.model.field.parameters()))
+
+    def test_frozen_weights_and_buffers_unchanged_after_optimizer(self):
+        self.model.train()
+        before={k:v.clone() for k,v in self.model.field.state_dict().items()}
+        opt=torch.optim.AdamW([p for p in self.model.parameters() if p.requires_grad],lr=1e-4)
+        self.model(self.pcd,self.q,self.visual).square().mean().backward()
+        opt.step()
+        self.assertTrue(all(torch.equal(v,before[k]) for k,v in self.model.field.state_dict().items()))
+
+    def test_descriptor_invariance(self):
+        p=self.pcd[0].permute(0,2,3,1).reshape(-1,3)
+        q=self.q[:1]
+        r,_=torch.linalg.qr(torch.randn(3,3));r[:,-1]*=torch.det(r)
+        t=torch.tensor([.2,.3,-.1])
+        z,c=self.model.encode_cloud(p)
+        z2,c2=self.model.encode_cloud(p@r.T+t)
+        torch.testing.assert_close(self.model.describe(z,c,q),self.model.describe(z2,c2,q@r.T+t),atol=3e-4,rtol=3e-3)
+
+    def test_chunking_matches_nonchunked_fusion(self):
+        other=FrozenNDFFusion(12,NDFConfig(latent_dim=8,num_points=32,query_chunk_size=100),False)
+        with torch.no_grad(): self.model.fusion.weight.normal_(0,.05)
+        other.load_state_dict(self.model.state_dict())
+        torch.testing.assert_close(self.model(self.pcd,self.q,self.visual),other(self.pcd,self.q,self.visual))
+
+    def test_new_input_changes_fused_output_when_ndf_weights_nonzero(self):
+        with torch.no_grad(): self.model.fusion.weight[:,12:].normal_(0,.1)
+        a=self.model(self.pcd,self.q,self.visual)
+        b=self.model(self.pcd,self.q+.1,self.visual)
+        self.assertGreater((a-b).abs().max().item(),1e-5)
+
+    def test_missing_pretrained_and_bad_geometry_fail(self):
+        with self.assertRaises(FileNotFoundError): FrozenNDFFusion(12,self.config)
+        with self.assertRaises(ValueError): self.model(torch.full_like(self.pcd,float('nan')),self.q,self.visual)
+        with self.assertRaises(ValueError): self.model(self.pcd,self.q[:,:2],self.visual)
+
+    def test_state_restore_without_external_ndf_file(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path=Path(tmp)/'state.pth'
+            torch.save(self.model.state_dict(),path)
+            restored=FrozenNDFFusion(12,self.config,False)
+            restored.load_state_dict(torch.load(path,weights_only=True),strict=True)
+            torch.testing.assert_close(self.model(self.pcd,self.q,self.visual),restored(self.pcd,self.q,self.visual))
